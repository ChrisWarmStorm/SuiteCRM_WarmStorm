<?php
if (!isset($sugar_config) || !is_array($sugar_config)) {
    $sugar_config = [];
}

if (!function_exists('suitecrm_env')) {
    function suitecrm_env($key, array $fallbacks = [])
    {
        $value = getenv($key);
        if ($value !== false && $value !== '') {
            return $value;
        }
        foreach ($fallbacks as $fallback) {
            $value = getenv($fallback);
            if ($value !== false && $value !== '') {
                return $value;
            }
        }
        return null;
    }
}

$dbHost = suitecrm_env('DB_HOST', ['MYSQLHOST', 'MARIADB_HOST', 'MYSQL_HOST']);
$dbPort = suitecrm_env('DB_PORT', ['MYSQLPORT', 'MARIADB_PORT', 'MYSQL_PORT']);
$dbName = suitecrm_env('DB_NAME', ['MYSQLDATABASE', 'MARIADB_DATABASE', 'MYSQL_DATABASE']);
$dbUser = suitecrm_env('DB_USER', ['MYSQLUSER', 'MARIADB_USER', 'MYSQL_USER']);
$dbPassword = suitecrm_env('DB_PASSWORD', ['MYSQLPASSWORD', 'MARIADB_PASSWORD', 'MYSQL_PASSWORD']);

$dbType = null;
$dbManager = null;
$dbUrl = suitecrm_env('DATABASE_URL');
if ($dbUrl !== null) {
    $parts = parse_url($dbUrl);
    if (is_array($parts)) {
        $scheme = isset($parts['scheme']) ? strtolower($parts['scheme']) : '';
        if (in_array($scheme, ['mysql', 'mariadb'], true)) {
            $dbType = 'mysqli';
            $dbManager = 'MysqliManager';
            $dbPort = $dbPort ?? '3306';
        }

        if (!empty($parts['host'])) {
            $dbHost = $parts['host'];
        }
        if (!empty($parts['port'])) {
            $dbPort = (string)$parts['port'];
        }
        if (!empty($parts['path'])) {
            $dbName = ltrim($parts['path'], '/');
        }
        if (!empty($parts['user'])) {
            $dbUser = urldecode($parts['user']);
        }
        if (!empty($parts['pass'])) {
            $dbPassword = urldecode($parts['pass']);
        }
    }
}

if ($dbHost !== null) {
    $sugar_config['dbconfig']['db_host_name'] = $dbHost;
}
if ($dbPort !== null) {
    $sugar_config['dbconfig']['db_port'] = $dbPort;
}
if ($dbName !== null) {
    $sugar_config['dbconfig']['db_name'] = $dbName;
}
if ($dbUser !== null) {
    $sugar_config['dbconfig']['db_user_name'] = $dbUser;
}
if ($dbPassword !== null) {
    $sugar_config['dbconfig']['db_password'] = $dbPassword;
}

if ($dbType !== null && empty($sugar_config['dbconfig']['db_type'])) {
    $sugar_config['dbconfig']['db_type'] = $dbType;
}
if ($dbManager !== null && empty($sugar_config['dbconfig']['db_manager'])) {
    $sugar_config['dbconfig']['db_manager'] = $dbManager;
}

$appUrl = suitecrm_env('PUBLIC_URL', ['SUITECRM_SITE_URL', 'APP_URL']);
if ($appUrl !== null) {
    $sugar_config['site_url'] = rtrim($appUrl, '/');
}
